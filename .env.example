# El Toro API credentials — copy this file to `.env` and fill in the real values.
# El Toro's team provisions these during onboarding (client-credentials grant).
# NEVER commit the real .env (it is git-ignored).
#
#   cp .env.example .env
#   # then paste your values below and `set -a; source .env; set +a` (or use a loader)

ELTORO_CLIENT_ID=paste-your-client-id-here
ELTORO_CLIENT_SECRET=paste-your-client-secret-here
